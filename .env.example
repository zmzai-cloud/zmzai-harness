# LLM 后端：zmzai-relay（OpenAI 兼容端点，createOpenAiModelProvider 读取）
# 鉴权走 relay 登录态（muzhi_session cookie），不要设置 OPENAI_API_KEY 占位符——
# relay 对无效 Bearer 直接 401，不会回退到 cookie 登录态
OPENAI_BASE_URL=https://m.zmzai.cloud/api/v1
OPENAI_MODEL=deepseek-chat

# relay 登录态：muzhi 登录地址 + 会话 cookie 名
MUZHI_URL=https://muzhi.zmzai.cloud
SESSION_COOKIE_NAME=muzhi_session

# 工作台本地目录
# 会话/历史持久化目录（JSONL）
ZMZAI_DATA_DIR=./.harness-data
# Agent 运行时的工作区根目录（直接读写本机文件/跑命令的地方）
ZMZAI_WORKSPACE=./.workspace
