# harness 发布 OSS 配置（复制为 .env.release 并填写真实值；.env.release 已 gitignore）
# muzhi 站的 .env.production.local 里 KEY/SECRET 可复用，但 Bucket 需另行提供——
# 桌面安装包走「对象级 public-read」，bucket 本身可保持私有。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：自定义 endpoint / 路径前缀 / 是否对象公共读（默认 true）
# OSS_ENDPOINT=
# OSS_PATH_PREFIX=releases/harness
# OSS_PUBLIC_ACL=true
